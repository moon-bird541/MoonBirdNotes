SECRET_KEY=replace-with-a-new-secret-key
DEBUG=True
# 硅基流动密钥只写入 backend/.env，禁止提交到 Git 或前端。
SILICONFLOW_API_KEY=your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# Knowledge Agent 主对话模型；真实 Key 只写入 Git 忽略的 backend/.env。
AGENT_LLM_PROVIDER=deepseek
AGENT_LLM_API_KEY=
AGENT_LLM_BASE_URL=https://api.deepseek.com
AGENT_LLM_MODEL=deepseek-v4-flash
AGENT_LLM_TIMEOUT_SECONDS=45
AGENT_LLM_MAX_OUTPUT_TOKENS=4096
AGENT_LLM_MAX_RETRIES=1
AGENT_LLM_RETRY_BACKOFF_SECONDS=0.5
AGENT_KNOWLEDGE_MAX_TOOL_STEPS=4
AGENT_KNOWLEDGE_TIMEOUT_SECONDS=90
AGENT_KNOWLEDGE_MAX_INPUT_CHARS=4000
AGENT_KNOWLEDGE_MAX_ANSWER_CHARS=8000
# 只重写检索查询，不修改用户可见问题。
AGENT_QUERY_REWRITE_ENABLED=True
AGENT_CONVERSATION_MAX_PER_USER=200
AGENT_CONVERSATION_RETENTION_DAYS=180
AGENT_RUN_TRACE_TTL_SECONDS=3600
# 按管理员账号限制 Knowledge Agent API 调用频率。
AGENT_KNOWLEDGE_CHAT_RATE=10/minute
RAG_EMBEDDING_PROVIDER=siliconflow
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_VERSION=siliconflow-bge-m3-input-v1
# 可选：相对路径以 backend 为基准；留空时从 Hugging Face 缓存或在线加载。
RAG_TOKENIZER_FILE=
RAG_EMBEDDING_INPUT_TEMPLATE_VERSION=bge-m3-unified-v1
RAG_EMBEDDING_NORMALIZE=True
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_TIMEOUT_SECONDS=30
RAG_EMBEDDING_MAX_RETRIES=2
RAG_EMBEDDING_RETRY_BACKOFF_SECONDS=0.5
RAG_EMBEDDING_MAX_INPUT_CHARS=32768
RAG_EMBEDDING_CACHE_TIMEOUT_SECONDS=604800
# 查询向量只做短期缓存，避免长期保留用户问题并支持模型配置快速切换。
RAG_QUERY_EMBEDDING_CACHE_TIMEOUT_SECONDS=300
# 与 Embedding 版本绑定；更换模型或输入模板后必须重新运行真实评测校准。
RAG_DENSE_SCORE_THRESHOLD=0.50
# 本地 Compose 默认不设置 Qdrant API Key；远程服务必须使用受保护连接。
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=moonbird_note_chunks_bge_m3_v1
QDRANT_VECTOR_NAME=dense
QDRANT_VECTOR_SIZE=1024
QDRANT_TIMEOUT_SECONDS=10
RAG_INDEX_DEBOUNCE_SECONDS=10
RAG_INDEX_MAX_ATTEMPTS=3
RAG_INDEX_RETRY_BASE_SECONDS=5
RAG_INDEX_LEASE_SECONDS=300
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_NAME=moonsbirdnotrs_db
DB_USER=root
DB_PASSWORD=your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
ADMIN_USERNAME=your-admin-username
# 仅用于首次创建默认管理员；已有账号改密请使用：
# python manage.py changepassword <ADMIN_USERNAME>
ADMIN_PASSWORD=your-admin-password
ADMIN_LOGIN_THROTTLE_RATE=5/minute
# 生产环境必须配置共享缓存，避免登录限流只在单个进程内生效。
# 示例：CACHE_URL=redis://127.0.0.1:6379/1
CACHE_URL=
